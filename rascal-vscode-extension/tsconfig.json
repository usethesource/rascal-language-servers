{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@tsconfig/node24/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "out",
    "types": [],
    "noEmit": true,
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "lib", "out"]
}
